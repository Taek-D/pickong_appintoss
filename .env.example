# 픽콩 (pickkong) — 환경 변수 예시
# 실제 값은 .env에 작성 (gitignore 됨)

# Backend port
PORT=8787
NODE_ENV=development

# Database (Postgres) — Supabase 또는 로컬 docker-compose
DATABASE_URL=postgres://pickkong:pickkong@localhost:5432/pickkong

# Session HMAC secret (32+ bytes, openssl rand -hex 32)
SESSION_SECRET=dev_secret_change_me_to_32_bytes_or_more_in_production

# Toss API (mTLS)
# 미설정 시 mock mode로 동작 (개발 환경 only)
TOSS_API_BASE=https://oauth2.cert.toss.im
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_MTLS_CERT_PATH=./certs/client-cert.pem
TOSS_MTLS_KEY_PATH=./certs/client-key.pem

# Sentry (mock by default)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Granite Analytics (mock by default)
GRANITE_ANALYTICS_KEY=

# Frontend public env (Vite는 VITE_ 접두사 필요)
VITE_API_BASE=/api
VITE_SENTRY_DSN=
VITE_TOSS_AD_GROUP_ID=
