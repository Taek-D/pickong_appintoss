# 픽콩 (pickkong) — 환경 변수 예시
# 실제 값은 .env에 작성 (gitignore 됨)

# Backend port
PORT=8787
NODE_ENV=development

# Database (Postgres) — Supabase 또는 로컬 docker-compose
DATABASE_URL=postgres://pickkong:pickkong@localhost:5432/pickkong

# Session HMAC secret (32+ bytes, openssl rand -hex 32)
SESSION_SECRET=dev_secret_change_me_to_32_bytes_or_more_in_production

# 앱인토스 토스 로그인 API (mTLS)
# 인증 방식: mTLS 클라이언트 인증서. client_id/secret 사용하지 않음.
# CERT/KEY 미설정 시 mock mode로 동작 (개발 환경 only)
TOSS_API_BASE=https://apps-in-toss-api.toss.im
TOSS_MTLS_CERT_PATH=./certs/client-cert.pem
TOSS_MTLS_KEY_PATH=./certs/client-key.pem

# Toss 연결 끊기 / 회원 탈퇴 콜백 Basic Auth
# 콘솔 "연결 끊기 콜백 URL" 등록 시 입력한 값과 동일하게 설정
# 생성 예: openssl rand -hex 16
TOSS_UNLINK_AUTH_USER=
TOSS_UNLINK_AUTH_PASS=

# Sentry (mock by default)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Granite Analytics (mock by default)
GRANITE_ANALYTICS_KEY=

# Supabase (Phase 1: 토스 로그인 Edge Function)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Frontend public env (Vite는 VITE_ 접두사 필요)
# ⚠️ 토스 미니앱 운영 빌드는 절대 URL 필수. /api 같은 상대 경로는 토스 도메인에서 백엔드로 라우팅 안 됨.
#    개발 시에는 vite proxy 와 함께 /api 사용 가능.
VITE_API_BASE=/api
VITE_SENTRY_DSN=

# 토스 미니앱 헤더에 표시되는 브랜드 아이콘 절대 URL (granite.config.ts 가 빌드 시 사용)
# 미설정 시 상대 경로 /icon.png 로 fallback → 토스 컨텍스트에서 깨져 기본 홈 아이콘으로 보임.
# 예) https://static.toss.im/appsintoss/<id>/<uuid>.png
PUBLIC_ICON_URL=

# 앱인토스 콘솔 → 광고 → 광고 그룹에서 발급
# 미설정 시 src/lib/ad.ts 가 silent skip (ad_skip_due_to_fail / ad_group_missing)
VITE_TOSS_AD_GROUP_ID=
