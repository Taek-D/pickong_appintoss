{
  "name": "pickkong-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "start": "node --env-file=../.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file=../.env src/migrate.ts",
    "expire": "tsx --env-file=../.env src/scripts/expire-cards.ts",
    "test": "node --test --import tsx test/character-rule.test.ts test/forbidden.test.ts test/share-message.test.ts test/toss-callback.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.13",
    "postgres": "^3.4.5",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0"
  },
  "engines": { "node": ">=22" }
}
