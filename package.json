{
  "name": "pickkong",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server -c green,cyan \"vite\" \"pnpm --dir server dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && pnpm --dir server typecheck",
    "lint": "tsc --noEmit",
    "db:migrate": "pnpm --dir server migrate",
    "test": "pnpm --dir server test",
    "submission:validate": "node scripts/validate-submission.mjs"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "2.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.1.0",
    "zustand": "^5.0.2",
    "zod": "^3.24.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
